{
  "expo": {
    "name": "Receiptly",
    "slug": "receiptly",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "receiptly",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.tejas.receiptly",
      "edgeToEdgeEnabled": true,
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Receiptly uses the camera to photograph receipts. Images stay on your device."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
